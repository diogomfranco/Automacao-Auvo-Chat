# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NÃO deve ser commitado (já está no .gitignore).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Caminho para o config_supabase.json (contém email/senha da conta de serviço
# usada para autenticar no Supabase). Pode ser um caminho local ou de rede.
CONFIG_SUPABASE_PATH=C:\Automacao\config_supabase.json
